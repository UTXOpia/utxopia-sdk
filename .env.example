# UTXOpia SDK environment template
# Copy to .env for local use. Do not commit real values.

UTXOPIA_NETWORK=devnet
UTXOPIA_SOLANA_RPC=https://api.devnet.solana.com
UTXOPIA_PROGRAM_ID=
UTXOPIA_ZKBTC_MINT=
# Privacy domain: public or institution.
UTXOPIA_PRIVACY_DOMAIN=public
MAGICBLOCK_POLICY_MODE=disabled
MAGICBLOCK_PER_URL=
MAGICBLOCK_PER_AUTH_TOKEN=

NEXT_PUBLIC_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_UTXOPIA_PROGRAM_ID=
NEXT_PUBLIC_ZKBTC_MINT=
NEXT_PUBLIC_BTC_NETWORK=testnet4
NEXT_PUBLIC_UTXOPIA_PRIVACY_DOMAIN=public

UTXOPIA_SUI_RELAYER_ADDRESS=
UTXOPIA_SUI_SIGNER_ADDRESS=
UTXOPIA_SUI_IKA_SUI_PAYMENT_NANOS=10000000

UTXOPIA_DEBUG=0
