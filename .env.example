NEXT_PUBLIC_UTXOPIA_EXECUTION_MODE=solana
NEXT_PUBLIC_UTXOPIA_PRIVACY_DOMAIN=public
NEXT_PUBLIC_MAGICBLOCK_ROUTER_URL=https://devnet-router.magicblock.app
NEXT_PUBLIC_MAGICBLOCK_ROUTER_WS_URL=wss://devnet-router.magicblock.app
NEXT_PUBLIC_MAGICBLOCK_VALIDATOR_REGION=asia
NEXT_PUBLIC_MAGICBLOCK_ER_URL=
NEXT_PUBLIC_MAGICBLOCK_PER_URL=

UTXOPIA_SUI_RELAYER_ADDRESS=
UTXOPIA_SUI_SIGNER_ADDRESS=
