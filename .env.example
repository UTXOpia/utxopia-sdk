# UTXOpia SDK environment template
# Copy to .env for local use. Do not commit real values.

UTXOPIA_NETWORK=devnet
UTXOPIA_SOLANA_RPC=https://api.devnet.solana.com
UTXOPIA_PROGRAM_ID=
UTXOPIA_ZKBTC_MINT=
UTXOPIA_EXECUTION_MODE=solana
# Privacy domain: public or institution.
UTXOPIA_PRIVACY_DOMAIN=public
MAGICBLOCK_ROUTER_URL=https://devnet-router.magicblock.app
MAGICBLOCK_ROUTER_WS_URL=wss://devnet-router.magicblock.app
MAGICBLOCK_VALIDATOR_REGION=asia
MAGICBLOCK_ER_URL=
MAGICBLOCK_PER_URL=

NEXT_PUBLIC_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_UTXOPIA_PROGRAM_ID=
NEXT_PUBLIC_ZKBTC_MINT=
